# ==== Resux — Apache/LiteSpeed config ====

# --- encoding & mime ---
AddDefaultCharset UTF-8
AddType 'application/javascript; charset=UTF-8' .js
AddType 'text/css; charset=UTF-8' .css

# --- compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- cache static assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType application/font-woff2 "access plus 365 days"
</IfModule>

# --- SEO: pretty URLs for /resume/{job}.html -> /resume/index.php ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # pass through real files/dirs
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /resume/anything.html handled by /resume/index.php
  RewriteRule ^resume/([a-z]+)\.html$ /resume/index.php [L,QSA]

  # /u/{slug} -> /u/index.php
  RewriteRule ^u/([a-z0-9]{6})/?$ /u/index.php [L,QSA]
</IfModule>

# --- security headers ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- block access to sqlite db and dotfiles ---
<FilesMatch "\.(sqlite|sqlite3|db|clean)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

ErrorDocument 404 /index.html
DirectoryIndex index.html index.php
